# Keep the build context lean. Commit sha for /version comes from Coolify's
# SOURCE_COMMIT build arg, not from .git, so it's excluded here.
.git/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
results/
*.log
.env
.env.local
website/frontend/dist/
website/frontend/node_modules/
